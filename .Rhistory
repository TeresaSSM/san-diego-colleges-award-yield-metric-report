library(pacman)
p_load(tidyverse, rmarkdown, knitr)
knitr::opts_chunk$set(echo = FALSE, message = FALSE, warning = FALSE)
source("CCCCO_Analysis_Script.R")
n_colleges  <- nrow(sd_data)
yield_min   <- min(sd_data$yield_per_100)
yield_max   <- max(sd_data$yield_per_100)
sdccd_max   <- sd_data %>% filter(district == "San Diego CCD")  %>% pull(yield_per_100) %>% max()
other_min   <- sd_data %>% filter(district != "San Diego CCD")  %>% pull(yield_per_100) %>% min()
n_degree_top <- sum(sd_data$Degree > sd_data$`Credit certificate` &
sd_data$Degree > sd_data$Noncredit)
cert_top     <- sd_data %>% slice_max(`Credit certificate`, n = 1) %>% pull(college)
```{r fig-overview, fig.width=7.5, fig.height=3.1, out.width="90%"}
# Chart 1: award yield, colored by district
fig1<-sd_data %>%
mutate(fill_group=case_when(district == "San Diego CCD" ~ "San Diego Community College District (SDCCD)",
TRUE ~ "Other districts"))%>%
ggplot(aes(x = reorder(college, yield_per_100), y = yield_per_100, fill = fill_group)) +
geom_col() +
geom_hline(yintercept = median_yield, linetype = "dashed") +
coord_flip() +
labs(title = "SDCCD's 3 colleges have the lowest award yields in the county",
subtitle = "Awards per 100 students, 2025-2026. Dashed line = statewide median of credit-based colleges",
x = NULL,
y = "Awards per 100 students")+ theme_stata() +
scale_fill_manual(values=c("gold", "#FFB600" ), name= NULL)+
theme(axis.text.y = element_text(angle = 0, hjust = 1))
